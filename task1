<?php
// Start the session to store expenses temporarily
session_start();

// Initialize the expenses array in the session if it doesn't exist
if (!isset($_SESSION['expenses'])) {
    $_SESSION['expenses'] = [];
}

// --- Handle Form Submissions ---

$category = '';
$amount = '';
$errors = [];
$results = null; // To store calculation results

// --- Handle Adding an Expense ---
// Validation happens *only* when adding an expense
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['add_expense'])) {
    $category = trim($_POST['category'] ?? '');
    $amount_str = trim($_POST['amount'] ?? '');

    // Basic Validation for adding expense
    if (empty($category)) {
        $errors[] = "Category cannot be empty.";
    }
    // Remove commas and check if numeric and positive
    $amount_val = str_replace(',', '', $amount_str);
    if (!is_numeric($amount_val) || $amount_val <= 0) {
        $errors[] = "Amount must be a positive number.";
    } else {
        $amount = floatval($amount_val); // Convert to float after validation
    }

    // If no errors, add to session
    if (empty($errors)) {
        $_SESSION['expenses'][] = ['category' => $category, 'amount' => $amount];
        // Clear form fields after successful addition
        $category = '';
        $amount = '';
        // Clear previous results and errors after successful add
        $results = null;
        $errors = [];
    }
}

// --- Handle Calculation ---
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['calculate'])) {
    $expenses = $_SESSION['expenses']; // Get expenses from session

    if (empty($expenses)) {
        $errors[] = "Please add at least one expense before calculating.";
        $results = null; // Ensure results are cleared if calculation fails
    } else {
        // 1. Calculate Total Expenses
        $totalExpenses = 0;
        foreach ($expenses as $expense) {
            $totalExpenses += $expense['amount'];
        }

        // 2. Calculate Average Daily Expense (Assuming 30 days)
        $daysInMonth = 30;
        $averageDailyExpense = ($totalExpenses > 0) ? $totalExpenses / $daysInMonth : 0;

        // 3. Find Top 3 Largest Expenses
        // Create a copy to sort, preserving original order in session if needed elsewhere
        $sortedExpenses = $expenses;
        usort($sortedExpenses, function($a, $b) {
            // Use spaceship operator (PHP 7+) for comparison
            return $b['amount'] <=> $a['amount'];
        });
        $top3Expenses = array_slice($sortedExpenses, 0, 3);

        // Store results
        $results = [
            'total' => $totalExpenses,
            'average_daily' => $averageDailyExpense,
            'top3' => $top3Expenses
        ];
        $errors = []; // Clear errors on successful calculation
    }
}

// --- Handle Reset ---
// Reset actions will now *always* run when the reset button is clicked,
// regardless of whether the list was already empty or fields were empty.
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['reset'])) {
    // Clear the list of expenses stored in the session.
    $_SESSION['expenses'] = [];
    // Clear any previously calculated results so they disappear from the page.
    $results = null;
    // Clear any error messages that might be displayed.
    $errors = [];
    // Reset the values in the input fields to empty strings.
    $category = '';
    $amount = '';
    // Note: The button itself might be visually disabled via HTML if the list *was* empty before clicking,
    // but the PHP logic here will still execute if the form is submitted.
}

